# Supabase project settings (the anon/publishable key is intended for browser use).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set this when the API is hosted separately. Locally, Vite proxies /api.
VITE_API_BASE_URL=

# Optional text-to-speech settings used by the frontend.
VITE_TTS_PROVIDER=mock
VITE_TTS_API_KEY=
